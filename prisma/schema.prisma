generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// SaaS / Multi-Tenant Core
// ============================================

model Tenant {
  id            String   @id @default(cuid())
  name          String
  domain        String?
  logo          String?
  status        String   @default("active") // active, suspended, deleted
  storageUsed   Float    @default(0)
  storageLimit  Float    @default(1024)
  activeUsers   Int      @default(0)
  userLimit     Int      @default(10)
  modulesEnabled String  @default("fleet,rental,customer,driver,fuel,maintenance")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users       User[]
  clients     Client[]
  vehicles    Vehicle[]
  customers   Customer[]
  drivers     Driver[]
  employees   Employee[]
  invoices    Invoice[]
  expenses    Expense[]
  documents   Document[]
}

// ============================================
// User & Authentication
// ============================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String
  avatar        String?
  role          String   @default("user") // super_owner, client_owner, fleet_manager, rental_manager, dispatcher, driver, accountant, hr_manager, mechanic, customer
  status        String   @default("active") // active, inactive, suspended
  tenantId      String?
  lastLogin     DateTime?
  lastLoginIp   String?
  mfaEnabled    Boolean  @default(false)
  mfaSecret     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  auditLogs     AuditLog[]
  devices       Device[]
  sessions      Session[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  deviceInfo   String?
  ipAddress    String?
  location     String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entity     String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}

// ============================================
// Owner Management Suite
// ============================================

model Client {
  id              String   @id @default(cuid())
  companyName     String
  contactPerson   String
  email           String
  phone           String?
  country         String?
  industryType    String?
  subscriptionPlan String  @default("trial")
  licenseStatus   String  @default("active")
  notes           String?
  status          String  @default("active") // active, suspended, deleted
  tenantId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
  subscription    Subscription?
  license         License?
  activities      ClientActivity[]
  purchases       PurchaseHistory[]
}

model ClientActivity {
  id         String   @id @default(cuid())
  clientId   String
  action     String
  details    String?
  createdAt  DateTime @default(now())

  client     Client   @relation(fields: [clientId], references: [id])
}

model PurchaseHistory {
  id          String   @id @default(cuid())
  clientId    String
  item        String
  amount      Float
  currency    String   @default("USD")
  status      String   @default("completed")
  purchaseDate DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id])
}

model Subscription {
  id              String   @id @default(cuid())
  clientId        String   @unique
  planType        String   @default("trial") // trial, monthly, annual, enterprise, custom
  startDate       DateTime
  expiryDate      DateTime
  renewalDate     DateTime?
  autoRenewal     Boolean  @default(false)
  activeModules   String   @default("fleet,rental,customer,driver")
  userLimit       Int      @default(5)
  storageLimit    Float    @default(1024)
  price           Float    @default(0)
  currency        String   @default("USD")
  status          String   @default("active") // active, suspended, cancelled, expired
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Client   @relation(fields: [clientId], references: [id])
}

model License {
  id              String   @id @default(cuid())
  clientId        String?  @unique
  licenseKey      String   @unique
  activationDate  DateTime?
  expiryDate      DateTime?
  status          String   @default("trial") // active, expired, suspended, trial
  maxDevices      Int      @default(3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Client?  @relation(fields: [clientId], references: [id])
}

model Device {
  id           String   @id @default(cuid())
  userId       String?
  deviceName   String
  browser      String?
  os           String?
  ipAddress    String?
  lastLogin    DateTime?
  location     String?
  status       String   @default("approved") // approved, blocked, pending
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id])
}

model Revenue {
  id              String   @id @default(cuid())
  category        String   // sales, subscription, renewal, other
  amount          Float
  currency        String   @default("USD")
  clientId        String?
  description     String?
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
}

model UpdateRecord {
  id              String   @id @default(cuid())
  version         String
  releaseNotes    String
  type            String   @default("minor") // major, minor, patch, critical
  isCritical      Boolean  @default(false)
  forceUpdate     Boolean  @default(false)
  status          String   @default("draft") // draft, published, deprecated
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// Fleet Management
// ============================================

model Vehicle {
  id                String   @id @default(cuid())
  vehicleNumber     String
  registrationNumber String  @unique
  vin               String?
  chassisNumber     String?
  engineNumber      String?
  make              String
  model             String
  year              Int
  category          String   @default("sedan") // sedan, suv, truck, bus, van, equipment, luxury
  fuelType          String   @default("petrol") // petrol, diesel, electric, hybrid, cng
  transmission      String   @default("automatic") // automatic, manual
  seatingCapacity   Int      @default(5)
  mileage           Float    @default(0)
  currentLocation   String?
  status            String   @default("available") // available, reserved, rented, maintenance, in_service, retired
  color             String?
  dailyRate         Float    @default(0)
  weeklyRate        Float    @default(0)
  monthlyRate       Float    @default(0)
  purchaseDate      DateTime?
  purchasePrice     Float    @default(0)
  currentValue      Float    @default(0)
  imageUrl          String?
  tenantId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant?  @relation(fields: [tenantId], references: [id])
  reservations      Reservation[]
  rentalContracts   RentalContract[]
  fuelRecords       FuelRecord[]
  maintenanceRecords MaintenanceRecord[]
  damages           DamageReport[]
  insurancePolicies InsurancePolicy[]
  complianceRecords ComplianceRecord[]
  vehicleDocuments  Document[]
  gpsLocations      GpsLocation[]
  inspections       VehicleInspection[]
}

model VehicleInspection {
  id            String   @id @default(cuid())
  vehicleId     String
  inspectorName String
  inspectionDate DateTime
  nextDueDate   DateTime?
  type          String   @default("routine") // routine, safety, emissions, pre_rental, post_rental
  status        String   @default("passed") // passed, failed, pending
  notes         String?
  findings      String?
  createdAt     DateTime @default(now())

  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
}

model GpsLocation {
  id          String   @id @default(cuid())
  vehicleId   String
  latitude    Float
  longitude   Float
  speed       Float    @default(0)
  heading     Float    @default(0)
  altitude    Float    @default(0)
  timestamp   DateTime @default(now())

  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
}

// ============================================
// Customer Management
// ============================================

model Customer {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  companyName     String?
  companyRegNumber String?
  taxId           String?
  drivingLicense  String?
  licenseExpiry   DateTime?
  idType          String?  // passport, national_id, drivers_license
  idNumber        String?
  dateOfBirth     DateTime?
  notes           String?
  status          String   @default("active") // active, inactive, blacklisted
  creditRating    String   @default("good") // excellent, good, fair, poor
  tenantId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
  reservations    Reservation[]
  rentalContracts RentalContract[]
  invoices        Invoice[]
  damageReports   DamageReport[]
  documents       Document[]
}

// ============================================
// Driver Management
// ============================================

model Driver {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String
  address         String?
  city            String?
  country         String?
  licenseNumber   String
  licenseClass    String?
  licenseExpiry   DateTime
  licenseIssuing  String?
  certifications  String?
  employmentDate  DateTime?
  employmentType  String   @default("full_time") // full_time, part_time, contract
  status          String   @default("active") // active, inactive, on_leave, terminated
  drivingHours    Float    @default(0)
  violations      Int      @default(0)
  incidents       Int      @default(0)
  rating          Float    @default(5.0)
  fuelEfficiency  Float    @default(0)
  baseSalary      Float    @default(0)
  imageUrl        String?
  tenantId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
  trips           Trip[]
  dispatchOrders  DispatchOrder[]
  fuelRecords     FuelRecord[]
}

// ============================================
// Vehicle Rental Management
// ============================================

model Reservation {
  id              String   @id @default(cuid())
  reservationCode String   @unique
  customerId      String
  vehicleId       String
  startDate       DateTime
  endDate         DateTime
  actualReturnDate DateTime?
  pickupLocation  String?
  returnLocation  String?
  dailyRate       Float
  totalAmount     Float
  depositAmount   Float    @default(0)
  status          String   @default("pending") // pending, confirmed, active, completed, cancelled, no_show
  notes           String?
  approvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer        Customer     @relation(fields: [customerId], references: [id])
  vehicle         Vehicle      @relation(fields: [vehicleId], references: [id])
  contract        RentalContract?
  extensions      RentalExtension[]
}

model RentalContract {
  id              String   @id @default(cuid())
  contractNumber  String   @unique
  reservationId   String   @unique
  customerId      String
  vehicleId       String
  startDate       DateTime
  endDate         DateTime
  dailyRate       Float
  totalAmount     Float
  depositAmount   Float
  insuranceType   String   @default("basic") // none, basic, comprehensive, premium
  insuranceCost   Float    @default(0)
  terms           String?
  status          String   @default("active") // draft, active, completed, terminated
  signedDate      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reservation     Reservation  @relation(fields: [reservationId], references: [id])
  customer        Customer     @relation(fields: [customerId], references: [id])
  vehicle         Vehicle      @relation(fields: [vehicleId], references: [id])
  operations      RentalOperation[]
  deposits        Deposit[]
  damages         DamageReport[]
}

model RentalOperation {
  id              String   @id @default(cuid())
  contractId      String
  type            String   // pickup, return, extension, exchange, late_return
  performedBy     String?
  performedAt     DateTime @default(now())
  notes           String?
  mileageAtTime   Float?
  fuelLevelAtTime String?
  conditionNotes  String?
  createdAt       DateTime @default(now())

  contract        RentalContract @relation(fields: [contractId], references: [id])
}

model RentalExtension {
  id              String   @id @default(cuid())
  reservationId   String
  requestedDate   DateTime @default(now())
  newEndDate      DateTime
  additionalAmount Float
  status          String   @default("pending") // pending, approved, rejected
  approvedBy      String?
  notes           String?
  createdAt       DateTime @default(now())

  reservation     Reservation @relation(fields: [reservationId], references: [id])
}

model Deposit {
  id              String   @id @default(cuid())
  contractId      String
  amount          Float
  type            String   @default("collection") // collection, refund, adjustment, deduction
  method          String   @default("cash") // cash, card, bank_transfer, check
  reason          String?
  status          String   @default("collected") // collected, refunded, partial_refund, forfeited
  createdAt       DateTime @default(now())

  contract        RentalContract @relation(fields: [contractId], references: [id])
}

model DamageReport {
  id              String   @id @default(cuid())
  contractId      String?
  vehicleId       String
  customerId      String?
  reportedDate    DateTime @default(now())
  description     String
  imageUrl        String?
  repairEstimate  Float    @default(0)
  repairCost      Float    @default(0)
  customerLiability Float  @default(0)
  status          String   @default("reported") // reported, assessed, repairing, repaired, closed
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contract        RentalContract? @relation(fields: [contractId], references: [id])
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id])
  customer        Customer?  @relation(fields: [customerId], references: [id])
}

// ============================================
// Transport Operations
// ============================================

model DispatchOrder {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  vehicleId       String?
  driverId        String?
  routeName       String?
  origin          String
  destination     String
  scheduledDeparture DateTime
  scheduledArrival   DateTime?
  status          String   @default("pending") // pending, dispatched, in_transit, completed, cancelled
  priority        String   @default("normal") // low, normal, high, urgent
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  driver          Driver?   @relation(fields: [driverId], references: [id])
  trips           Trip[]
}

model Trip {
  id              String   @id @default(cuid())
  dispatchOrderId String
  driverId        String?
  distance        Float    @default(0)
  eta             DateTime?
  actualArrival   DateTime?
  delayMinutes    Int      @default(0)
  fuelConsumed    Float    @default(0)
  routePerformance Float   @default(0)
  status          String   @default("planned") // planned, in_progress, completed, cancelled
  notes           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  dispatchOrder   DispatchOrder @relation(fields: [dispatchOrderId], references: [id])
  driver          Driver?   @relation(fields: [driverId], references: [id])
  fuelRecords     FuelRecord[]
}

// ============================================
// Fuel Management
// ============================================

model FuelRecord {
  id              String   @id @default(cuid())
  vehicleId       String
  driverId        String?
  tripId          String?
  fuelType        String   @default("petrol")
  quantity        Float
  costPerUnit     Float
  totalCost       Float
  mileageAtFill   Float?
  vendor          String?
  fuelCard        String?
  date            DateTime @default(now())
  createdAt       DateTime @default(now())

  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  driver          Driver?  @relation(fields: [driverId], references: [id])
  trip            Trip?    @relation(fields: [tripId], references: [id])
}

// ============================================
// Maintenance Management
// ============================================

model MaintenanceRecord {
  id              String   @id @default(cuid())
  vehicleId       String
  type            String   @default("preventive") // preventive, corrective
  category        String   @default("oil_change") // oil_change, tire_replacement, inspection, service, repair, body_work, electrical, ac, brake, other
  description     String
  scheduledDate   DateTime?
  completedDate   DateTime?
  cost            Float    @default(0)
  vendor          String?
  status          String   @default("scheduled") // scheduled, in_progress, completed, cancelled
  nextDueDate     DateTime?
  nextDueMileage  Float?
  notes           String?
  workOrderId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  jobCard         JobCard?
  spareParts      MaintenancePart[]
}

model MaintenancePart {
  id              String   @id @default(cuid())
  maintenanceId   String
  partId          String?
  partName        String
  quantity        Int      @default(1)
  unitCost        Float    @default(0)
  totalCost       Float    @default(0)
  createdAt       DateTime @default(now())

  maintenance     MaintenanceRecord @relation(fields: [maintenanceId], references: [id])
}

// ============================================
// Workshop Management
// ============================================

model JobCard {
  id              String   @id @default(cuid())
  maintenanceId   String   @unique
  mechanicName    String
  laborHours      Float    @default(0)
  laborCost       Float    @default(0)
  priority        String   @default("normal") // low, normal, high, urgent
  status          String   @default("open") // open, in_progress, completed, closed
  startDate       DateTime?
  completionDate  DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  maintenance     MaintenanceRecord @relation(fields: [maintenanceId], references: [id])
}

// ============================================
// Spare Parts Inventory
// ============================================

model SparePart {
  id              String   @id @default(cuid())
  partNumber      String   @unique
  name            String
  description     String?
  category        String?
  supplier        String?
  warehouse       String?
  quantityInStock Int      @default(0)
  reorderLevel    Int      @default(5)
  unitCost        Float    @default(0)
  sellingPrice    Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrders  PurchaseOrderItem[]
  stockTransfers  StockTransfer[]
  adjustments     InventoryAdjustment[]
  goodsReceipts   GoodsReceiptItem[]
}

model PurchaseOrder {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  supplier        String
  status          String   @default("draft") // draft, submitted, approved, received, cancelled
  totalAmount     Float    @default(0)
  orderDate       DateTime @default(now())
  expectedDate    DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  partId          String?
  partName        String
  quantity        Int
  unitCost        Float
  totalCost       Float
  receivedQty     Int      @default(0)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  part            SparePart?    @relation(fields: [partId], references: [id])
}

model StockTransfer {
  id              String   @id @default(cuid())
  partId          String
  fromWarehouse   String
  toWarehouse     String
  quantity        Int
  status          String   @default("pending") // pending, completed, cancelled
  transferDate    DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  part            SparePart @relation(fields: [partId], references: [id])
}

model InventoryAdjustment {
  id              String   @id @default(cuid())
  partId          String
  adjustmentType  String   @default("increase") // increase, decrease
  quantity        Int
  reason          String?
  adjustedBy      String?
  adjustmentDate  DateTime @default(now())
  createdAt       DateTime @default(now())

  part            SparePart @relation(fields: [partId], references: [id])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  receiptNumber   String   @unique
  supplier        String
  purchaseOrderId String?
  receivedDate    DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  items           GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id              String   @id @default(cuid())
  goodsReceiptId  String
  partId          String?
  partName        String
  quantityReceived Int
  unitCost        Float
  condition       String   @default("good") // good, damaged, returned

  goodsReceipt    GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  part            SparePart?   @relation(fields: [partId], references: [id])
}

// ============================================
// Financial Management
// ============================================

model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique
  customerId      String?
  type            String   @default("rental") // rental, transport, fuel, service, other
  amount          Float
  tax             Float    @default(0)
  totalAmount     Float
  status          String   @default("pending") // draft, pending, paid, partial, overdue, cancelled
  dueDate         DateTime
  paidDate        DateTime?
  tenantId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer        Customer?  @relation(fields: [customerId], references: [id])
  tenant          Tenant?    @relation(fields: [tenantId], references: [id])
  payments        Payment[]
  items           InvoiceItem[]
}

model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  description     String
  quantity        Int      @default(1)
  unitPrice       Float
  total           Float

  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id              String   @id @default(cuid())
  invoiceId       String
  amount          Float
  method          String   @default("cash") // cash, card, bank_transfer, check, online
  reference       String?
  status          String   @default("completed") // pending, completed, failed, refunded
  paidDate        DateTime @default(now())
  createdAt       DateTime @default(now())

  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
}

model Expense {
  id              String   @id @default(cuid())
  category        String   // maintenance, fuel, payroll, insurance, permits, office, other
  amount          Float
  description     String?
  vendor          String?
  date            DateTime @default(now())
  status          String   @default("pending") // pending, approved, paid, rejected
  approvedBy      String?
  tenantId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
}

model JournalEntry {
  id              String   @id @default(cuid())
  entryNumber     String   @unique
  date            DateTime @default(now())
  description     String?
  debitAccount    String
  creditAccount   String
  amount          Float
  reference       String?
  status          String   @default("draft") // draft, posted, reversed
  createdAt       DateTime @default(now())
}

// ============================================
// Insurance & Compliance
// ============================================

model InsurancePolicy {
  id              String   @id @default(cuid())
  vehicleId       String
  policyNumber    String
  provider        String
  type            String   @default("comprehensive") // liability, comprehensive, collision, personal_injury
  premium         Float
  startDate       DateTime
  endDate         DateTime
  status          String   @default("active") // active, expired, cancelled, claimed
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
}

model ComplianceRecord {
  id              String   @id @default(cuid())
  vehicleId       String
  type            String   // road_tax, permit, fitness_certificate, emission, registration, other
  certificateNumber String?
  issuingAuthority String?
  issueDate       DateTime?
  expiryDate      DateTime
  status          String   @default("valid") // valid, expired, pending_renewal, revoked
  reminderDays    Int      @default(30)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
}

// ============================================
// Human Resources
// ============================================

model Employee {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  department      String?
  position        String?
  employmentDate  DateTime?
  terminationDate DateTime?
  status          String   @default("active") // active, on_leave, terminated
  baseSalary      Float    @default(0)
  tenantId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
  attendance      Attendance[]
  leaveRecords    LeaveRecord[]
  payrollRecords  PayrollRecord[]
  performanceReviews PerformanceReview[]
}

model Attendance {
  id              String   @id @default(cuid())
  employeeId      String
  date            DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  hoursWorked     Float    @default(0)
  status          String   @default("present") // present, absent, late, half_day, holiday
  notes           String?
  createdAt       DateTime @default(now())

  employee        Employee @relation(fields: [employeeId], references: [id])
}

model LeaveRecord {
  id              String   @id @default(cuid())
  employeeId      String
  leaveType       String   @default("annual") // annual, sick, maternity, paternity, unpaid, other
  startDate       DateTime
  endDate         DateTime
  days            Int
  status          String   @default("pending") // pending, approved, rejected
  approvedBy      String?
  notes           String?
  createdAt       DateTime @default(now())

  employee        Employee @relation(fields: [employeeId], references: [id])
}

model PayrollRecord {
  id              String   @id @default(cuid())
  employeeId      String
  periodStart     DateTime
  periodEnd       DateTime
  baseSalary      Float
  overtime        Float    @default(0)
  deductions      Float    @default(0)
  bonuses         Float    @default(0)
  netPay          Float
  status          String   @default("pending") // pending, processed, paid
  paidDate        DateTime?
  createdAt       DateTime @default(now())

  employee        Employee @relation(fields: [employeeId], references: [id])
}

model PerformanceReview {
  id              String   @id @default(cuid())
  employeeId      String
  reviewerName    String
  period          String
  rating          Float    @default(0)
  goals           String?
  achievements    String?
  feedback        String?
  reviewDate      DateTime @default(now())
  createdAt       DateTime @default(now())

  employee        Employee @relation(fields: [employeeId], references: [id])
}

// ============================================
// Document Management
// ============================================

model Document {
  id              String   @id @default(cuid())
  title           String
  category        String   @default("general") // contract, license, insurance, vehicle, compliance, general
  fileName        String
  fileUrl         String
  fileSize        Float    @default(0)
  mimeType        String?
  version         Int      @default(1)
  vehicleId       String?
  customerId      String?
  tenantId        String?
  uploadedBy      String?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id])
  customer        Customer? @relation(fields: [customerId], references: [id])
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])
}
