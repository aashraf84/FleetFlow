generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

// ============================================
// CENTRAL PLATFORM DATABASE
// Stores: Auth, Tenant Management, Clients, Subscriptions, Licenses
// Each registered Client gets their own separate database (ff_<slug>)
// ============================================

// ============================================
// Tenant (represents a company/organization)
// Each tenant has their OWN separate database
// ============================================

model Tenant {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique // used for DB name: ff_<slug>
  domain         String?
  logo           String?
  status         String   @default("active") // active, suspended, deleted
  dbName         String   @unique // actual database name for this tenant
  dbReady        Boolean  @default(false) // true after tenant DB is provisioned
  storageUsed    Float    @default(0)
  storageLimit   Float    @default(1024)
  activeUsers    Int      @default(0)
  userLimit      Int      @default(10)
  modulesEnabled String   @default("fleet,rental,customer,driver,fuel,maintenance")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users    User[]
  clients  Client[]
  settings TenantSettings[]
}

// ============================================
// User & Authentication
// ============================================

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  password    String
  avatar      String?
  role        String    @default("user") // super_owner, client_owner, fleet_manager, rental_manager, dispatcher, driver, accountant, hr_manager, mechanic, customer
  status      String    @default("active") // active, inactive, suspended
  tenantId    String?
  lastLogin   DateTime?
  lastLoginIp String?
  mfaEnabled  Boolean   @default(false)
  mfaSecret   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant?    @relation(fields: [tenantId], references: [id])
  auditLogs AuditLog[]
  devices   Device[]
  sessions  Session[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  deviceInfo String?
  ipAddress  String?
  location   String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ============================================
// Owner Management Suite (Platform-Level)
// ============================================

model Client {
  id               String   @id @default(cuid())
  companyName      String
  slug             String   @unique // used for tenant DB naming
  contactPerson    String
  email            String
  phone            String?
  country          String?
  industryType     String?
  subscriptionPlan String   @default("trial")
  licenseStatus    String   @default("active")
  notes            String?
  status           String   @default("active") // active, suspended, deleted
  tenantId         String? // links to their dedicated tenant DB
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant       Tenant?           @relation(fields: [tenantId], references: [id])
  subscription Subscription?
  license      License?
  activities   ClientActivity[]
  purchases    PurchaseHistory[]
  revenues     Revenue[]
}

model ClientActivity {
  id        String   @id @default(cuid())
  clientId  String
  action    String
  details   String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
}

model PurchaseHistory {
  id           String   @id @default(cuid())
  clientId     String
  item         String
  amount       Float
  currency     String   @default("USD")
  status       String   @default("completed")
  purchaseDate DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
}

model Subscription {
  id            String    @id @default(cuid())
  clientId      String    @unique
  planType      String    @default("trial") // trial, monthly, annual, enterprise, custom
  startDate     DateTime
  expiryDate    DateTime
  renewalDate   DateTime?
  autoRenewal   Boolean   @default(false)
  activeModules String    @default("fleet,rental,customer,driver")
  userLimit     Int       @default(5)
  storageLimit  Float     @default(1024)
  price         Float     @default(0)
  currency      String    @default("USD")
  status        String    @default("active") // active, suspended, cancelled, expired
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id])
}

model License {
  id             String    @id @default(cuid())
  clientId       String?   @unique
  licenseKey     String    @unique
  activationDate DateTime?
  expiryDate     DateTime?
  status         String    @default("trial") // active, expired, suspended, trial
  maxDevices     Int       @default(3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
}

model Device {
  id         String    @id @default(cuid())
  userId     String?
  deviceName String
  browser    String?
  os         String?
  ipAddress  String?
  lastLogin  DateTime?
  location   String?
  status     String    @default("approved") // approved, blocked, pending
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Revenue {
  id          String   @id @default(cuid())
  category    String // sales, subscription, renewal, other
  amount      Float
  currency    String   @default("USD")
  clientId    String?
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id])
}

model UpdateRecord {
  id           String    @id @default(cuid())
  version      String
  releaseNotes String
  type         String    @default("minor") // major, minor, patch, critical
  isCritical   Boolean   @default(false)
  forceUpdate  Boolean   @default(false)
  status       String    @default("draft") // draft, published, deprecated
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ============================================
// Tenant Settings (stored in central DB with tenantId for multi-tenancy)
// Categories: general, receipt, invoice, payment, tax, email, notification, security, appearance
// ============================================

model TenantSettings {
  id        String   @id @default(cuid())
  tenantId  String // links to tenant; "default" for demo/global settings
  category  String // general, receipt, invoice, payment, tax, email, notification, security, appearance
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, category])
}

// ============================================
// FLEET MANAGEMENT MODELS
// ============================================

// ============================================
// Vehicle
// ============================================

model Vehicle {
  id                 String    @id @default(cuid())
  vehicleNumber      String
  registrationNumber String
  make               String
  model              String
  year               Int
  category           String // sedan, suv, truck, van, bus, luxury
  color              String?
  vin                String?
  engineNumber       String?
  transmission       String?
  fuelType           String // petrol, diesel, electric, hybrid
  mileage            Float     @default(0)
  status             String    @default("available") // available, rented, reserved, maintenance, in_service, retired
  dailyRate          Float
  weeklyRate         Float?
  monthlyRate        Float?
  currentLocation    String?
  lastServiceDate    DateTime?
  nextServiceDate    DateTime?
  insuranceExpiry    DateTime?
  registrationExpiry DateTime?
  notes              String?
  tenantId           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  reservations       Reservation[]
  rentalContracts    RentalContract[]
  maintenanceRecords MaintenanceRecord[]
  inspections        VehicleInspection[]
  fuelRecords        FuelRecord[]
  insurancePolicies  InsurancePolicy[]
  damageReports      DamageReport[]
  gpsLocations       GpsLocation[]
  complianceRecords  ComplianceRecord[]
  trips              Trip[]
}

// ============================================
// Customer
// ============================================

model Customer {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String
  email            String    @unique
  phone            String
  address          String?
  city             String?
  country          String?
  nationality      String?
  idNumber         String?
  drivingLicense   String?
  licenseExpiry    DateTime?
  dateOfBirth      DateTime?
  emergencyContact String?
  emergencyPhone   String?
  status           String    @default("active")
  notes            String?
  totalRentals     Int       @default(0)
  totalSpent       Float     @default(0)
  tenantId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reservations    Reservation[]
  rentalContracts RentalContract[]
  deposits        Deposit[]
  damageReports   DamageReport[]
  invoices        Invoice[]
}

// ============================================
// Driver
// ============================================

model Driver {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String
  email            String?   @unique
  phone            String
  licenseNumber    String
  licenseExpiry    DateTime?
  licenseClass     String?
  address          String?
  city             String?
  nationality      String?
  dateOfBirth      DateTime?
  hireDate         DateTime?
  status           String    @default("active") // active, off-duty, suspended, terminated
  rating           Float     @default(0)
  totalTrips       Int       @default(0)
  totalDistance    Float     @default(0)
  emergencyContact String?
  notes            String?
  tenantId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  trips          Trip[]
  dispatchOrders DispatchOrder[]
  fuelRecords    FuelRecord[]
}

// ============================================
// Reservation
// ============================================

model Reservation {
  id              String   @id @default(cuid())
  reservationCode String   @unique
  customerId      String
  vehicleId       String
  startDate       DateTime
  endDate         DateTime
  pickupLocation  String?
  returnLocation  String?
  totalAmount     Float    @default(0)
  depositAmount   Float    @default(0)
  status          String   @default("pending") // pending, confirmed, active, completed, cancelled, no_show
  notes           String?
  tenantId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id])
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id])
  rentalContract RentalContract?
}

// ============================================
// RentalContract
// ============================================

model RentalContract {
  id             String    @id @default(cuid())
  contractNumber String    @unique
  reservationId  String?   @unique
  customerId     String
  vehicleId      String
  startDate      DateTime
  endDate        DateTime
  dailyRate      Float
  totalDays      Int
  totalAmount    Float
  depositAmount  Float     @default(0)
  mileageLimit   Float?
  mileageOut     Float     @default(0)
  mileageIn      Float     @default(0)
  terms          String?
  status         String    @default("active") // draft, active, completed, terminated, breached
  signedDate     DateTime?
  returnDate     DateTime?
  notes          String?
  tenantId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reservation  Reservation?  @relation(fields: [reservationId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id])
  deposits     Deposit[]
  damageReport DamageReport?
}

// ============================================
// Deposit
// ============================================

model Deposit {
  id             String    @id @default(cuid())
  contractId     String
  customerId     String?
  amount         Float
  type           String // security, advance, other
  status         String    @default("held") // held, returned, partially_returned, forfeited
  method         String?
  returnedDate   DateTime?
  returnedAmount Float     @default(0)
  notes          String?
  tenantId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  contract RentalContract @relation(fields: [contractId], references: [id])
  customer Customer?      @relation(fields: [customerId], references: [id])
}

// ============================================
// DamageReport
// ============================================

model DamageReport {
  id             String   @id @default(cuid())
  vehicleId      String
  customerId     String?
  contractId     String?  @unique
  reportedDate   DateTime
  description    String
  severity       String // minor, moderate, major, total
  location       String?
  repairCost     Float    @default(0)
  insuranceClaim Boolean  @default(false)
  status         String   @default("reported") // reported, assessed, repairing, repaired, closed
  photos         String?
  notes          String?
  tenantId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vehicle  Vehicle         @relation(fields: [vehicleId], references: [id])
  customer Customer?       @relation(fields: [customerId], references: [id])
  contract RentalContract? @relation(fields: [contractId], references: [id])
}

// ============================================
// Trip
// ============================================

model Trip {
  id              String    @id @default(cuid())
  dispatchOrderId String?
  driverId        String
  vehicleId       String?
  origin          String
  destination     String
  startTime       DateTime
  endTime         DateTime?
  distance        Float     @default(0)
  status          String    @default("planned") // planned, in_progress, completed, cancelled
  notes           String?
  tenantId        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dispatchOrder DispatchOrder? @relation(fields: [dispatchOrderId], references: [id])
  driver        Driver         @relation(fields: [driverId], references: [id])
  vehicle       Vehicle?       @relation(fields: [vehicleId], references: [id])
  fuelRecords   FuelRecord[]
}

// ============================================
// DispatchOrder
// ============================================

model DispatchOrder {
  id            String    @id @default(cuid())
  orderNumber   String    @unique
  driverId      String?
  priority      String    @default("normal") // low, normal, high, urgent
  origin        String
  destination   String
  scheduledTime DateTime?
  completedTime DateTime?
  instructions  String?
  status        String    @default("pending") // pending, assigned, in_progress, completed, cancelled
  tenantId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  driver Driver? @relation(fields: [driverId], references: [id])
  trips  Trip[]
}

// ============================================
// GpsLocation
// ============================================

model GpsLocation {
  id        String   @id @default(cuid())
  vehicleId String
  latitude  Float
  longitude Float
  speed     Float    @default(0)
  heading   Float    @default(0)
  timestamp DateTime
  tenantId  String?
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

// ============================================
// MaintenanceRecord
// ============================================

model MaintenanceRecord {
  id            String    @id @default(cuid())
  vehicleId     String
  type          String // preventive, corrective, emergency
  category      String // engine, brakes, tires, electrical, body, other
  description   String
  scheduledDate DateTime
  completedDate DateTime?
  cost          Float     @default(0)
  vendor        String?
  odometer      Float?
  status        String    @default("scheduled") // scheduled, in_progress, completed, cancelled
  priority      String    @default("normal") // low, normal, high, urgent
  notes         String?
  tenantId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vehicle    Vehicle                @relation(fields: [vehicleId], references: [id])
  jobCard    JobCard?
  spareParts MaintenanceSparePart[]
}

// ============================================
// JobCard
// ============================================

model JobCard {
  id             String   @id @default(cuid())
  maintenanceId  String   @unique
  technician     String?
  estimatedHours Float    @default(0)
  actualHours    Float    @default(0)
  laborCost      Float    @default(0)
  partsCost      Float    @default(0)
  totalCost      Float    @default(0)
  status         String   @default("open") // open, in_progress, completed, closed
  notes          String?
  tenantId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  maintenance MaintenanceRecord @relation(fields: [maintenanceId], references: [id])
}

// ============================================
// SparePart
// ============================================

model SparePart {
  id              String   @id @default(cuid())
  name            String
  partNumber      String?
  category        String?
  quantityInStock Int      @default(0)
  reorderLevel    Int      @default(5)
  unitCost        Float
  sellingPrice    Float?
  supplier        String?
  location        String?
  tenantId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  maintenanceLinks   MaintenanceSparePart[]
  purchaseOrderItems PurchaseOrderItem[]
}

// ============================================
// MaintenanceSparePart (explicit join model for M:N MaintenanceRecord <-> SparePart)
// ============================================

model MaintenanceSparePart {
  id            String   @id @default(cuid())
  maintenanceId String
  sparePartId   String
  quantity      Int      @default(1)
  cost          Float    @default(0)
  createdAt     DateTime @default(now())

  maintenance MaintenanceRecord @relation(fields: [maintenanceId], references: [id])
  sparePart   SparePart         @relation(fields: [sparePartId], references: [id])

  @@unique([maintenanceId, sparePartId])
}

// ============================================
// PurchaseOrder
// ============================================

model PurchaseOrder {
  id           String    @id @default(cuid())
  orderNumber  String    @unique
  supplier     String?
  totalAmount  Float     @default(0)
  status       String    @default("pending") // pending, approved, ordered, received, cancelled
  orderedDate  DateTime?
  receivedDate DateTime?
  notes        String?
  tenantId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items PurchaseOrderItem[]
}

// ============================================
// PurchaseOrderItem
// ============================================

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  sparePartId     String?
  partName        String
  quantity        Int
  unitCost        Float
  totalCost       Float
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  sparePart     SparePart?    @relation(fields: [sparePartId], references: [id])
}

// ============================================
// VehicleInspection
// ============================================

model VehicleInspection {
  id                 String    @id @default(cuid())
  vehicleId          String
  inspectionDate     DateTime
  inspector          String?
  type               String // pre_rental, post_rental, routine, safety
  overallCondition   String // excellent, good, fair, poor
  exteriorCondition  String?
  interiorCondition  String?
  engineCondition    String?
  tireCondition      String?
  brakesCondition    String?
  notes              String?
  issues             String?
  photos             String?
  status             String    @default("passed") // passed, failed, conditional
  nextInspectionDate DateTime?
  tenantId           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

// ============================================
// Expense
// ============================================

model Expense {
  id            String   @id @default(cuid())
  category      String // fuel, maintenance, insurance, salary, rent, utilities, other
  amount        Float
  date          DateTime
  description   String?
  vendor        String?
  receiptNumber String?
  status        String   @default("completed") // pending, approved, completed, rejected
  paymentMethod String?
  tenantId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// Invoice
// ============================================

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  customerId    String
  issueDate     DateTime
  dueDate       DateTime
  subtotal      Float
  taxAmount     Float     @default(0)
  totalAmount   Float
  paidAmount    Float     @default(0)
  status        String    @default("draft") // draft, sent, paid, partial, overdue, cancelled
  paidDate      DateTime?
  notes         String?
  tenantId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer Customer      @relation(fields: [customerId], references: [id])
  items    InvoiceItem[]
  payments Payment[]
}

// ============================================
// InvoiceItem
// ============================================

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  total       Float
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

// ============================================
// Payment
// ============================================

model Payment {
  id        String   @id @default(cuid())
  invoiceId String?
  amount    Float
  method    String // cash, card, bank_transfer, cheque, online
  reference String?
  paidDate  DateTime
  status    String   @default("completed") // pending, completed, failed, refunded
  notes     String?
  tenantId  String?
  createdAt DateTime @default(now())

  invoice Invoice? @relation(fields: [invoiceId], references: [id])
}

// ============================================
// JournalEntry
// ============================================

model JournalEntry {
  id           String   @id @default(cuid())
  entryNumber  String   @unique
  date         DateTime
  description  String?
  account      String
  debitAmount  Float    @default(0)
  creditAmount Float    @default(0)
  amount       Float    @default(0)
  type         String // debit, credit
  reference    String?
  status       String   @default("draft") // draft, posted, void
  tenantId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================
// InsurancePolicy
// ============================================

model InsurancePolicy {
  id           String   @id @default(cuid())
  vehicleId    String
  policyNumber String
  provider     String
  type         String // comprehensive, third_party, collision
  premium      Float
  startDate    DateTime
  endDate      DateTime
  coverage     String?
  deductible   Float    @default(0)
  status       String   @default("active") // active, expired, cancelled, claimed
  notes        String?
  tenantId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

// ============================================
// Employee
// ============================================

model Employee {
  id               String   @id @default(cuid())
  employeeId       String   @unique
  firstName        String
  lastName         String
  email            String?
  phone            String?
  department       String // operations, maintenance, finance, hr, admin, dispatch
  position         String
  hireDate         DateTime
  salary           Float    @default(0)
  status           String   @default("active") // active, on_leave, suspended, terminated
  address          String?
  emergencyContact String?
  notes            String?
  tenantId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attendance         Attendance[]
  leaveRecords       LeaveRecord[]
  payrollRecords     PayrollRecord[]
  performanceReviews PerformanceReview[]
}

// ============================================
// Attendance
// ============================================

model Attendance {
  id          String    @id @default(cuid())
  employeeId  String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Float     @default(0)
  status      String    @default("present") // present, absent, late, half_day, leave
  notes       String?
  createdAt   DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

// ============================================
// LeaveRecord
// ============================================

model LeaveRecord {
  id         String   @id @default(cuid())
  employeeId String
  type       String // annual, sick, personal, maternity, unpaid
  startDate  DateTime
  endDate    DateTime
  days       Int
  status     String   @default("pending") // pending, approved, rejected, cancelled
  reason     String?
  approvedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

// ============================================
// PayrollRecord
// ============================================

model PayrollRecord {
  id          String   @id @default(cuid())
  employeeId  String
  period      String   // e.g. "2024-01"
  baseSalary  Float    @default(0)
  overtime    Float    @default(0)
  bonuses     Float    @default(0)
  deductions  Float    @default(0)
  netPay      Float    @default(0)
  status      String   @default("pending") // pending, processed, paid
  paidDate    DateTime?
  notes       String?
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

// ============================================
// PerformanceReview
// ============================================

model PerformanceReview {
  id           String   @id @default(cuid())
  employeeId   String
  reviewer     String
  period       String   // e.g. "2024-Q1"
  rating       Float    @default(0) // 1-5
  goals        String?
  feedback     String?
  strengths    String?
  improvements String?
  status       String   @default("draft") // draft, submitted, acknowledged
  reviewDate   DateTime
  tenantId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

// ============================================
// ComplianceRecord
// ============================================

model ComplianceRecord {
  id               String    @id @default(cuid())
  vehicleId        String
  type             String // registration, inspection, permit, certification, other
  documentNumber   String?
  issueDate        DateTime?
  expiryDate       DateTime
  issuingAuthority String?
  status           String    @default("valid") // valid, expired, pending, renewal_required
  notes            String?
  tenantId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

// ============================================
// Document
// ============================================

model Document {
  id              String   @id @default(cuid())
  title           String
  type            String // contract, invoice, receipt, inspection, insurance, other
  category        String?
  fileName        String?
  fileUrl         String?
  fileSize        Float?
  relatedEntity   String?
  relatedEntityId String?
  uploadedBy      String?
  status          String   @default("active") // active, archived, deleted
  notes           String?
  tenantId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// FuelRecord
// ============================================

model FuelRecord {
  id            String   @id @default(cuid())
  vehicleId     String
  driverId      String?
  date          DateTime
  fuelType      String?
  quantity      Float    @default(0)
  unitPrice     Float    @default(0)
  totalCost     Float    @default(0)
  odometer      Float?
  station       String?
  receiptNumber String?
  status        String   @default("completed") // pending, completed
  notes         String?
  tenantId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tripId  String?
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver? @relation(fields: [driverId], references: [id])
  trip    Trip?   @relation(fields: [tripId], references: [id])
}
